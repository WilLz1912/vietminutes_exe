# Sao chép thành .env rồi điền key. Không commit file .env.

# Môi trường 1 – chép lời + tách người nói: mock | soniox | deepgram
STT_PROVIDER=mock
SONIOX_API_KEY=
SONIOX_MODEL=stt-async-v5
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3

# Môi trường 2 – tạo biên bản: mock | gemini
LLM_PROVIDER=mock
# Dùng key của project đã bật thanh toán (gói trả phí không dùng dữ liệu để huấn luyện)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Giới hạn thời gian mỗi hộp (giây)
SANDBOX_TIMEOUT_STT=900
SANDBOX_TIMEOUT_LLM=300
# Kết quả chưa được web nhận sẽ tự xóa sau (giây)
RESULT_TTL=900
# Origin của web app được phép gọi API
WEB_ORIGIN=http://localhost:3000
